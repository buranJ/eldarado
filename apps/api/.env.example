# Подключение к Postgres. Базу создать: createdb gamestock
DATABASE_URL="postgresql://USER@localhost:5432/gamestock"

# Порт HTTP API
PORT=3001
HOST=127.0.0.1

# Публичный адрес интерфейса. Используется для CORS и проверки запросов.
APP_ORIGIN=http://localhost:5173

# 32 случайных байта в base64 для шифрования пользовательских API-ключей.
# Создать: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# Ключ Claude API — нужен начиная с этапа 2 (AI-анализ).
# На этапе 1 можно не заполнять.
ANTHROPIC_API_KEY=

# Eldorado Seller API: создаются в кабинете продавца и обмениваются на
# короткоживущий Bearer-токен. Никогда не коммитить ClientSecret.
ELDORADO_CLIENT_ID=
ELDORADO_CLIENT_SECRET=

# Модель для извлечения характеристик (по умолчанию claude-opus-5).
# Для дешёвых тестовых прогонов: claude-sonnet-5
ANALYSIS_MODEL=
