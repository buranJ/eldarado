# Copy this file to .env.production on the server. Never commit the real file.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://gamestock:replace-with-a-long-random-password@db:5432/gamestock
APP_ORIGIN=https://example.com
CREDENTIAL_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64
GAMESTOCK_DATA_DIR=/opt/gamestock-data
GAMESTOCK_BACKUP_DIR=/opt/gamestock-backups
BACKUP_RETENTION_DAYS=1
BACKUP_INTERVAL_SECONDS=86400
BACKUP_MIN_AGE_SECONDS=82800

# Optional operations alerting. The endpoint must accept a JSON {"text":"..."} payload.
MONITOR_INTERVAL_SECONDS=300
MONITOR_DISK_USED_PERCENT=85
MONITOR_WEBHOOK_URL=
MONITOR_TLS_HOST=example.com
MONITOR_TLS_EXPIRY_DAYS=14
MONITOR_BACKUP_MAX_AGE_SECONDS=129600

# Optional S3-compatible off-site backup (Cloudflare R2, AWS S3, Backblaze B2).
S3_PROVIDER=Other
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_PREFIX=gamestock/
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional password recovery email. All values are required to activate it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GameStock <no-reply@example.com>

# Optional error analytics. Frontend and backend projects may use separate DSNs.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Optional fallbacks for the first registered profile.
ANTHROPIC_API_KEY=
ELDORADO_CLIENT_ID=
ELDORADO_CLIENT_SECRET=
ANALYSIS_MODEL=claude-opus-5
