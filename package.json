{
  "name": "gamestock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @gamestock/web",
    "dev:api": "npm run dev --workspace @gamestock/api",
    "collect": "npm run collect --workspace @gamestock/api --",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "e2e": "playwright test",
    "db:push": "npm run db:push --workspace @gamestock/api",
    "db:studio": "npm run db:studio --workspace @gamestock/api",
    "analyze": "npm run analyze --workspace @gamestock/api --"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
